# /etc/comfyture/judge.env for the judges' copy (mode 0600, owned by root). Copy this file there and fill the key.
# Each line is read by server/main.ts or server/judge.ts; the defaults are said beside each one.

# the judges' own key, on an account funded with only what you are ready to spend ($15-20): its balance is the last cap
COMFY_API_KEY=comfyui-…
# no partner model, writer or template can run (server/comfy-templates.ts refuses partner templates too)
COMFYTURE_OPEN_WEIGHTS=1
# judge mode: no key or address changes from the page, nothing kept can be deleted, writes paced, renders and answers capped
COMFYTURE_JUDGE=1
# renders a visitor may start in a day (default 12)
COMFYTURE_JUDGE_RUNS=8
# renders everyone together may start in a day (default 80)
COMFYTURE_JUDGE_RUNS_DAY=40
# renders one address may start in a day, whoever is behind it (default three visitors' worth): each browser is a visitor of its own
# by a cookie the copy gives it, so judges behind one office's address do not share one allowance, and clearing the cookie gives none back
COMFYTURE_JUDGE_RUNS_ADDRESS=24
# pet and writer answers a visitor may get in a day (default 80)
COMFYTURE_JUDGE_WORDS=60
# an empty folder of its own: the server seeds every product's examples into it, and nothing of anyone's own work is ever there
COMFYTURE_DATA=/var/lib/comfyture/data
# listen on this machine only: Caddy is the way in (HTTPS and a password)
HOST=127.0.0.1
PORT=5177
