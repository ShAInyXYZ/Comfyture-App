# Comfy Cloud: a key from platform.comfy.org (needs a paid Cloud plan).
COMFY_API_KEY=

# Your own ComfyUI instead: run `comfy-api-proxy run` and point here.
# Leave both empty to use http://127.0.0.1:8189.
COMFY_BASE_URL=

# The Stage's assistant runs on Claude Haiku through Comfy Router with the key above.
# COMFYTURE_ASSISTANT=gemma keeps it on Gemma 4 inside ComfyUI (open weights).

# PORT=5177
