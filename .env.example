# Comfyture's settings. Copy this file to .env and fill in what you need; everything is optional.
# With nothing set, the app opens on its examples and tours (nothing is spent) and looks for your own
# ComfyUI behind comfy-api-proxy at http://127.0.0.1:8189 for real renders.

# Comfy Cloud: a key from platform.comfy.org/profile/api-keys. It also pays for partner models on Comfy Router.
# A key saved in the app (the account window, top right) outranks this one.
COMFY_API_KEY=

# Your own ComfyUI instead: start `comfy-api-proxy run` next to it and put its address here.
# The account window's "Renders on" switch outranks this (docs/guides/LOCAL-COMFYUI.md).
COMFY_BASE_URL=
# The token your bridge asks for, when it was started with `comfy-api-proxy run --token …` (sent to your bridge only).
# COMFY_PROXY_TOKEN=

# Open weights only: no partner writer, image, video or template model is offered or run.
# COMFYTURE_OPEN_WEIGHTS=1

# The writers' and the quick assistants' default models (each bar can pick another):
# COMFYTURE_LLM=claude-sonnet-5-5          # Story, Cut and Jam's writer; gemma-4 keeps it open weights
# COMFYTURE_LLM_ASSISTANT=gpt-6-luna       # the pets, Shot and the Stage; gemma-4 keeps them open weights

# Where the app listens, and where it keeps your work.
# PORT=5177
# HOST=127.0.0.1
# COMFYTURE_DATA=data
