{
  "photo": {
    "class_type": "LoadImage",
    "inputs": {
      "image": ""
    }
  },
  "prompt": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": ""
    }
  },
  "seconds": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 2
    }
  },
  "fps": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 12
    }
  },
  "small": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "photo",
        0
      ],
      "upscale_method": "bilinear",
      "megapixels": 0.25,
      "resolution_steps": 8
    }
  },
  "frames": {
    "class_type": "RepeatImageBatch",
    "inputs": {
      "image": [
        "small",
        0
      ],
      "amount": 24
    }
  },
  "clip": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "frames",
        0
      ],
      "fps": 12
    }
  },
  "video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "clip",
        0
      ],
      "filename_prefix": "comfyture/dev-shot",
      "format": "auto",
      "codec": "auto"
    }
  }
}
