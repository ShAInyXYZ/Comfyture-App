{
  "video_in": {"class_type": "LoadVideo", "inputs": {"file": ""}},
  "parts": {"class_type": "GetVideoComponents", "inputs": {"video": ["video_in", 0]}},
  "video_vae": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "audio_vae": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.5-audio-vae-bf16.safetensors"}},
  "picture": {"class_type": "VAEEncode", "inputs": {"pixels": ["parts", 0], "vae": ["video_vae", 0]}},
  "picture_frozen": {"class_type": "LTXVFreezeLatent", "inputs": {"latent": ["picture", 0]}},
  "frames": {"class_type": "PrimitiveInt", "inputs": {"value": 121}},
  "fps": {"class_type": "PrimitiveInt", "inputs": {"value": 24}},
  "fps_float": {"class_type": "ComfyMathExpression", "inputs": {"expression": "a", "values.a": ["fps", 0]}},
  "sound_empty": {"class_type": "LTXVEmptyLatentAudio", "inputs": {"frames_number": ["frames", 0], "frame_rate": ["fps", 0], "batch_size": 1, "audio_vae": ["audio_vae", 0]}},
  "av": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["picture_frozen", 0], "audio_latent": ["sound_empty", 0]}},
  "model": {"class_type": "UNETLoader", "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "text_encoder": {"class_type": "CLIPLoader", "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}},
  "prompt": {"class_type": "PrimitiveStringMultiline", "inputs": {"value": ""}},
  "positive": {"class_type": "CLIPTextEncode", "inputs": {"text": ["prompt", 0], "clip": ["text_encoder", 0]}},
  "negative": {"class_type": "CLIPTextEncode", "inputs": {"text": "silence, muffled or distorted audio, hum, clipping, low quality", "clip": ["text_encoder", 0]}},
  "conditioning": {"class_type": "LTXVConditioning", "inputs": {"positive": ["positive", 0], "negative": ["negative", 0], "frame_rate": ["fps_float", 0]}},
  "guider": {"class_type": "LTXVDualCFGGuider", "inputs": {"model": ["model", 0], "positive": ["conditioning", 0], "negative": ["conditioning", 1], "video_cfg": 1, "audio_cfg": 1}},
  "sampler": {"class_type": "SamplerEulerAncestral", "inputs": {"eta": 0, "s_noise": 1}},
  "sigmas": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "seed": {"class_type": "RandomNoise", "inputs": {"noise_seed": 0}},
  "sample": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["seed", 0], "guider": ["guider", 0], "sampler": ["sampler", 0], "sigmas": ["sigmas", 0], "latent_image": ["av", 0]}},
  "split": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["sample", 1]}},
  "sound": {"class_type": "LTXVAudioVAEDecode", "inputs": {"samples": ["split", 1], "audio_vae": ["audio_vae", 0]}},
  "with_sound": {"class_type": "CreateVideo", "inputs": {"images": ["parts", 0], "fps": ["parts", 2], "audio": ["sound", 0], "bit_depth": 8, "color_space": "sRGB", "codec": "none"}},
  "video": {"class_type": "SaveVideo", "inputs": {"video": ["with_sound", 0], "filename_prefix": "comfyture/sound", "format": "auto", "format.codec": "auto"}}
}
