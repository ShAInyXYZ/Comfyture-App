{
  "track": { "class_type": "LoadAudio", "inputs": { "audio": "" } },
  "stems": { "class_type": "AudioStemSeparate", "inputs": { "audio": ["track", 0], "model_name": "htdemucs_ft" } },
  "words": { "class_type": "AudioSpeechToTextWhisper", "inputs": { "audio": ["stems", 0], "model_size": "large-v2", "language": "Auto-Detect", "task": "Transcribe", "generate_srt": true, "srt_max_line_len": 32, "srt_max_lines": 1, "srt_max_duration_sec": 4 } },
  "srt": { "class_type": "SaveText", "inputs": { "text": ["words", 1], "filename_prefix": "comfyture/jam-lyrics", "format": "txt" } },
  "tempo": { "class_type": "AudioBPMDetector", "inputs": { "audio": ["track", 0], "fps": 24 } },
  "tempo_text": { "class_type": "PreviewAny", "inputs": { "source": ["tempo", 0] } },
  "bpm": { "class_type": "SaveText", "inputs": { "text": ["tempo_text", 0], "filename_prefix": "comfyture/jam-bpm", "format": "txt" } },
  "beats_text": { "class_type": "PreviewAny", "inputs": { "source": ["tempo", 1] } },
  "beats": { "class_type": "SaveText", "inputs": { "text": ["beats_text", 0], "filename_prefix": "comfyture/jam-beats", "format": "txt" } },
  "vocals": { "class_type": "SaveAudioMP3", "inputs": { "audio": ["stems", 0], "filename_prefix": "comfyture/jam-vocals", "quality": "320k" } }
}
