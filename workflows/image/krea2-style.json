{
  "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "krea2_turbo_int8_convrot.safetensors", "weight_dtype": "default"}},
  "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default"}},
  "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "text": {"class_type": "PrimitiveStringMultiline", "inputs": {"value": ""}},
  "seed": {"class_type": "PrimitiveInt", "inputs": {"value": 0}},
  "width": {"class_type": "PrimitiveInt", "inputs": {"value": 1024}},
  "height": {"class_type": "PrimitiveInt", "inputs": {"value": 1024}},
  "size": {"class_type": "EmptyLatentImage", "inputs": {"width": ["width", 0], "height": ["height", 0], "batch_size": 1}},
  "lora": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["unet", 0], "lora_name": "krea2_style_reference.safetensors", "strength_model": 1}},
  "shift": {"class_type": "ModelSamplingFlux", "inputs": {"model": ["lora", 0], "max_shift": 1.15, "base_shift": 0.5, "width": ["width", 0], "height": ["height", 0]}},
  "enc": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "prompt": ["text", 0]}},
  "refs": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["enc", 0], "reference_latents_method": "index_timestep_zero"}},
  "negative": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["enc", 0]}},
  "guider": {"class_type": "CFGGuider", "inputs": {"model": ["shift", 0], "positive": ["refs", 0], "negative": ["negative", 0], "cfg": 1}},
  "noise": {"class_type": "RandomNoise", "inputs": {"noise_seed": ["seed", 0]}},
  "pick": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "sigmas": {"class_type": "BasicScheduler", "inputs": {"model": ["shift", 0], "scheduler": "simple", "steps": 8, "denoise": 1}},
  "sampler": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["pick", 0], "sigmas": ["sigmas", 0], "latent_image": ["size", 0]}},
  "decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}},
  "frame": {"class_type": "SaveImageAdvanced", "inputs": {"images": ["decode", 0], "filename_prefix": "comfyture/krea2-style", "format": "png", "format.bit_depth": "8-bit", "format.input_color_space": "sRGB"}}
}
