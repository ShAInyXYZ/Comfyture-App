{
 "ckpt": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "ace_step_1.5_turbo_aio.safetensors"
  },
  "_meta": {
   "title": "Music for a cut: ACE-Step 1.5 turbo (all in one), as Comfy's official audio_ace_step_1_5_checkpoint template wires it. The prompt fills tags; lyrics, seconds, bpm and the seed are set per request."
  }
 },
 "shift": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "ckpt",
    0
   ],
   "shift": 3
  }
 },
 "text": {
  "class_type": "TextEncodeAceStepAudio1.5",
  "inputs": {
   "clip": [
    "ckpt",
    1
   ],
   "tags": "",
   "lyrics": "[Instrumental]",
   "seed": 0,
   "bpm": 100,
   "duration": 30,
   "timesignature": "4",
   "language": "en",
   "keyscale": "C major",
   "generate_audio_codes": true,
   "cfg_scale": 2,
   "temperature": 0.85,
   "top_p": 0.9,
   "top_k": 0,
   "min_p": 0
  }
 },
 "negative": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "text",
    0
   ]
  }
 },
 "latent": {
  "class_type": "EmptyAceStep1.5LatentAudio",
  "inputs": {
   "seconds": 30,
   "batch_size": 1
  }
 },
 "sample": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "shift",
    0
   ],
   "seed": 0,
   "steps": 8,
   "cfg": 1,
   "sampler_name": "euler",
   "scheduler": "simple",
   "positive": [
    "text",
    0
   ],
   "negative": [
    "negative",
    0
   ],
   "latent_image": [
    "latent",
    0
   ],
   "denoise": 1
  }
 },
 "decode": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": [
    "sample",
    0
   ],
   "vae": [
    "ckpt",
    2
   ]
  }
 },
 "out": {
  "class_type": "SaveAudioMP3",
  "inputs": {
   "audio": [
    "decode",
    0
   ],
   "filename_prefix": "comfyture/music",
   "quality": "V0"
  }
 }
}