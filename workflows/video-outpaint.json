{
 "unet": { "class_type": "UNETLoader", "inputs": { "unet_name": "ltx-2.5-22b-distilled-transformer-bf16.safetensors", "weight_dtype": "default" } },
 "ic_lora": { "class_type": "LTXICLoRALoaderModelOnly", "inputs": { "model": ["unet", 0], "lora_name": "ltx-2.3-22b-ic-lora-in-outpainting-0.9.safetensors", "strength_model": 1 } },
 "text_encoder": { "class_type": "CLIPLoader", "inputs": { "clip_name": "gemma4-12b-with-proj-ltx-2.5-bf16.safetensors", "type": "ltxv", "device": "default" } },
 "vae": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-video-vae-bf16.safetensors" } },
 "audio_vae": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-audio-vae-bf16.safetensors" } },

 "prompt": { "class_type": "PrimitiveStringMultiline", "inputs": { "value": "" } },
 "positive": { "class_type": "CLIPTextEncode", "inputs": { "text": ["prompt", 0], "clip": ["text_encoder", 0] } },
 "negative": { "class_type": "CLIPTextEncode", "inputs": { "text": "blurry, low quality, distorted, deformed, extra limbs, extra people, text, watermark, borders, letterbox, frame, split screen, flickering", "clip": ["text_encoder", 0] } },
 "conditioning": { "class_type": "LTXVConditioning", "inputs": { "positive": ["positive", 0], "negative": ["negative", 0], "frame_rate": 24 } },

 "video_in": { "class_type": "LoadVideo", "inputs": { "file": "" } },
 "frames": { "class_type": "GetVideoComponents", "inputs": { "video": ["video_in", 0] } },
 "fit": { "class_type": "ResizeImageMaskNode", "inputs": { "input": ["frames", 0], "resize_type": "scale dimensions", "resize_type.width": 1152, "resize_type.height": 768, "resize_type.crop": "disabled", "scale_method": "lanczos" } },
 "pad": { "class_type": "ImagePadForOutpaint", "inputs": { "image": ["fit", 0], "left": 0, "top": 0, "right": 0, "bottom": 0, "feathering": 0 } },
 "size": { "class_type": "GetImageSize", "inputs": { "image": ["pad", 0] } },
 "mask_image": { "class_type": "MaskToImage", "inputs": { "mask": ["pad", 1] } },
 "mask_frames": { "class_type": "RepeatImageBatch", "inputs": { "image": ["mask_image", 0], "amount": ["size", 2] } },
 "mask": { "class_type": "ImageToMask", "inputs": { "image": ["mask_frames", 0], "channel": "red" } },
 "keyed": { "class_type": "LTXVInpaintPreprocess", "inputs": { "images": ["pad", 0], "mask": ["mask", 0] } },

 "pad_half": { "class_type": "ResizeImageMaskNode", "inputs": { "input": ["pad", 0], "resize_type": "scale by multiplier", "resize_type.multiplier": 0.5, "scale_method": "area" } },
 "mask_half": { "class_type": "ResizeImageMaskNode", "inputs": { "input": ["mask", 0], "resize_type": "scale by multiplier", "resize_type.multiplier": 0.5, "scale_method": "area" } },
 "keyed_half": { "class_type": "LTXVInpaintPreprocess", "inputs": { "images": ["pad_half", 0], "mask": ["mask_half", 0] } },
 "size_half": { "class_type": "GetImageSize", "inputs": { "image": ["keyed_half", 0] } },
 "latent": { "class_type": "EmptyLTXVLatentVideo", "inputs": { "width": ["size_half", 0], "height": ["size_half", 1], "length": ["size_half", 2], "batch_size": 1 } },

 "start": { "class_type": "ImageFromBatch", "inputs": { "image": ["pad", 0], "batch_index": 0, "length": 1 } },
 "start_half": { "class_type": "ResizeImageMaskNode", "inputs": { "input": ["start", 0], "resize_type": "scale by multiplier", "resize_type.multiplier": 0.5, "scale_method": "area" } },
 "start_prep": { "class_type": "LTXVPreprocess", "inputs": { "image": ["start_half", 0], "img_compression": 18 } },
 "first": { "class_type": "LTXVImgToVideoConditionOnly", "inputs": { "vae": ["vae", 0], "image": ["start_prep", 0], "latent": ["latent", 0], "strength": 0.7, "bypass": true } },
 "guide": { "class_type": "LTXAddVideoICLoRAGuideAdvanced", "inputs": { "positive": ["conditioning", 0], "negative": ["conditioning", 1], "vae": ["vae", 0], "latent": ["first", 0], "image": ["keyed_half", 0], "frame_idx": 0, "strength": 1, "latent_downscale_factor": ["ic_lora", 1], "crop": "disabled", "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64, "attention_strength": 1, "use_streaming": false, "tile_frames": 97 } },
 "audio_latent": { "class_type": "VAEEncodeAudio", "inputs": { "audio": ["frames", 1], "vae": ["audio_vae", 0] } },
 "audio_ref": { "class_type": "LTXVSetAudioRefTokens", "inputs": { "positive": ["guide", 0], "negative": ["guide", 1], "audio_latent": ["audio_latent", 0] } },
 "av": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["guide", 2], "audio_latent": ["audio_ref", 2] } },

 "noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": 43 } },
 "guider": { "class_type": "CFGGuider", "inputs": { "model": ["ic_lora", 0], "positive": ["guide", 0], "negative": ["guide", 1], "cfg": 1 } },
 "sampler": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
 "sigmas": { "class_type": "ManualSigmas", "inputs": { "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0" } },
 "sample": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sampler", 0], "sigmas": ["sigmas", 0], "latent_image": ["av", 0] } },
 "split": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["sample", 1] } },
 "crop": { "class_type": "LTXVCropGuides", "inputs": { "positive": ["guide", 0], "negative": ["guide", 1], "latent": ["split", 0] } },
 "decode": { "class_type": "VAEDecodeTiled", "inputs": { "samples": ["crop", 2], "vae": ["vae", 0], "tile_size": 512, "overlap": 64, "temporal_size": 128, "temporal_overlap": 32 } },
 "blend": { "class_type": "LTXVLaplacianPyramidBlend", "inputs": { "image_a": ["decode", 0], "image_b": ["keyed_half", 0], "mask": ["mask_half", 0], "trim_to_shortest": true, "mask_low_res_dilation": 5 } },

 "up": { "class_type": "ResizeImageMaskNode", "inputs": { "input": ["blend", 0], "resize_type": "scale by multiplier", "resize_type.multiplier": 2, "scale_method": "lanczos" } },
 "encode": { "class_type": "VAEEncodeTiled", "inputs": { "pixels": ["up", 0], "vae": ["vae", 0], "tile_size": 512, "overlap": 64, "temporal_size": 500, "temporal_overlap": 64 } },
 "first_refine": { "class_type": "LTXVImgToVideoConditionOnly", "inputs": { "vae": ["vae", 0], "image": ["start", 0], "latent": ["encode", 0], "strength": 1, "bypass": true } },
 "audio_ref_refine": { "class_type": "LTXVSetAudioRefTokens", "inputs": { "positive": ["crop", 0], "negative": ["crop", 1], "audio_latent": ["split", 1] } },
 "av_refine": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["first_refine", 0], "audio_latent": ["audio_ref_refine", 2] } },
 "noise_refine": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
 "guider_refine": { "class_type": "CFGGuider", "inputs": { "model": ["ic_lora", 0], "positive": ["crop", 0], "negative": ["crop", 1], "cfg": 1 } },
 "sampler_refine": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
 "sigmas_refine": { "class_type": "ManualSigmas", "inputs": { "sigmas": "0.7250, 0.4219, 0.0" } },
 "sample_refine": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["noise_refine", 0], "guider": ["guider_refine", 0], "sampler": ["sampler_refine", 0], "sigmas": ["sigmas_refine", 0], "latent_image": ["av_refine", 0] } },
 "split_refine": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["sample_refine", 0] } },
 "decode_refine": { "class_type": "VAEDecodeTiled", "inputs": { "samples": ["split_refine", 0], "vae": ["vae", 0], "tile_size": 512, "overlap": 64, "temporal_size": 128, "temporal_overlap": 32 } },
 "blend_refine": { "class_type": "LTXVLaplacianPyramidBlend", "inputs": { "image_a": ["decode_refine", 0], "image_b": ["keyed", 0], "mask": ["mask", 0], "trim_to_shortest": true, "mask_low_res_dilation": 6 } },

 "create": { "class_type": "CreateVideo", "inputs": { "images": ["blend_refine", 0], "fps": ["frames", 2], "audio": ["frames", 1] } },
 "video": { "class_type": "SaveVideo", "inputs": { "video": ["create", 0], "filename_prefix": "comfyture/outpaint", "format": "auto", "codec": "auto" } }
}
