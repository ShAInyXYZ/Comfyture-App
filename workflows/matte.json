{
  "video_in": { "class_type": "LoadVideo", "inputs": { "file": "" } },
  "parts": { "class_type": "GetVideoComponents", "inputs": { "video": ["video_in", 0] } },
  "sam": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sam3.1_multiplex_fp16.safetensors" } },
  "words": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["sam", 1], "text": "" } },
  "key": { "class_type": "ImageFromBatch", "inputs": { "image": ["parts", 0], "batch_index": 0, "length": 1 } },
  "pick": { "class_type": "SAM3_Detect", "inputs": { "model": ["sam", 0], "image": ["key", 0], "positive_coords": "[]", "negative_coords": "[]", "threshold": 0.5, "refine_iterations": 2, "individual_masks": false } },
  "frames": { "class_type": "ImageFromBatch", "inputs": { "image": ["parts", 0], "batch_index": 0, "length": 4096 } },
  "track": { "class_type": "SAM3_VideoTrack", "inputs": { "images": ["frames", 0], "model": ["sam", 0], "initial_mask": ["pick", 0], "detection_threshold": 0.5, "max_objects": 1, "detect_interval": 1 } },
  "masks": { "class_type": "SAM3_TrackToMask", "inputs": { "track_data": ["track", 0], "object_indices": "" } },
  "pictures": { "class_type": "MaskToImage", "inputs": { "mask": ["masks", 0] } },
  "clip": { "class_type": "CreateVideo", "inputs": { "images": ["pictures", 0], "fps": ["parts", 2], "bit_depth": 8, "color_space": "sRGB", "codec": "none" } },
  "video": { "class_type": "SaveVideo", "inputs": { "video": ["clip", 0], "filename_prefix": "comfyture/matte", "format": "auto", "format.codec": "auto" } }
}
