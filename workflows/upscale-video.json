{
  "video_in": { "class_type": "LoadVideo", "inputs": { "file": "" } },
  "parts": { "class_type": "GetVideoComponents", "inputs": { "video": ["video_in", 0] } },
  "dit": { "class_type": "SeedVR2LoadDiTModel", "inputs": { "model": "seedvr2_ema_3b_fp8_e4m3fn.safetensors", "device": "cuda:0" } },
  "vae": { "class_type": "SeedVR2LoadVAEModel", "inputs": { "model": "ema_vae_fp16.safetensors", "device": "cuda:0" } },
  "up": { "class_type": "SeedVR2VideoUpscaler", "inputs": { "image": ["parts", 0], "dit": ["dit", 0], "vae": ["vae", 0], "seed": 42, "resolution": 1080, "max_resolution": 1920, "batch_size": 33, "uniform_batch_size": false, "color_correction": "lab" } },
  "with_sound": { "class_type": "CreateVideo", "inputs": { "images": ["up", 0], "fps": ["parts", 2], "audio": ["parts", 1], "bit_depth": 8, "color_space": "sRGB", "codec": "none" } },
  "video": { "class_type": "SaveVideo", "inputs": { "video": ["with_sound", 0], "filename_prefix": "comfyture/upscale-video", "format": "auto", "format.codec": "auto" } }
}
